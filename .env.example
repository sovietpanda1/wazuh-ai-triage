# Copy this file to .env and fill it in. Never commit .env (it is in .gitignore).

# --- General ---
TZ=Asia/Jerusalem

# Shared secret between Wazuh and n8n. Must match <api_key> in ossec.conf.
# REQUIRED: while it is empty the webhook refuses every alert (HTTP 503).
# At least 16 characters. install-integration.sh can generate one for you.
WEBHOOK_SECRET=

# Network address n8n listens on. 0.0.0.0 = whole LAN (then allow only the Wazuh
# manager's IP in the firewall). 127.0.0.1 = this machine only.
N8N_BIND=0.0.0.0

# --- Local LLM (any OpenAI-compatible server) ---
# LM Studio: http://host.docker.internal:1234/v1
# Ollama:    http://host.docker.internal:11434/v1
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_MODEL=qwen/qwen3.5-9b
LLM_API_KEY=local
# Longest answer the model may write (tokens). Reasoning models need more room.
LLM_MAX_TOKENS=2048

# --- Threat intel (optional; free key at https://www.abuseipdb.com) ---
ABUSEIPDB_API_KEY=

# --- Telegram notifications (see docs/setup-he.md) ---
# Messages contain host names, users, IPs and the AI summary, and go to Telegram's
# servers. Set TELEGRAM_ENABLED=false to keep everything local (results stay in
# n8n's execution history), or NOTIFY_REDACT=true to hide host and user names.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_REDACT=false

# --- Pipeline tuning ---
# Similar alerts (same rule + agent + level + source IP / file / Windows user) are
# analysed once per window (seconds). 0 turns grouping off. See README, "Deduplication".
DEDUP_WINDOW_SECONDS=600
# Heuristic risk score (1-100) at or above which the workflow reports "would block"
# (dry-run only). An invalid value turns block recommendations off.
BLOCK_THRESHOLD=80
# Comma-separated IPs/CIDRs that must never be blocked (e.g. your own public IP).
WHITELIST_CIDRS=

# --- Advanced: only change these for testing with tests/mock_services.py ---
# ABUSEIPDB_API_URL=https://api.abuseipdb.com/api/v2/check
# TELEGRAM_API_BASE=https://api.telegram.org
